# SellerHQ local/Vercel environment variables

# Browser Supabase client
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Supabase Edge Functions / secrets
# Set these with: supabase secrets set KEY=value
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Shared secret used by Vicarious Clothing and SellerHQ server-side sync.
# This must match SELLERHQ_API_KEY in the Vicarious Clothing Vercel project.
VICARIOUS_API_KEY=replace-with-at-least-32-random-bytes

# Vicarious endpoint that SellerHQ publishes products into.
VICARIOUS_PRODUCTS_ENDPOINT=https://vicariousclothing.co.uk/api/integrations/sellerhq/products

# Optional but recommended. Restricts trusted Vicarious pull/update/order calls
# to Henry's Vicarious business in SellerHQ.
VICARIOUS_BUSINESS_ID=replace-with-sellerhq-business-id
